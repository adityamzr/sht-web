# SHT Web — environment variables (PUBLIC ONLY)

# ⚠️ PRODUCTION CONFIG (M0): nilai berikut masih PLACEHOLDER.
# Ganti dengan nilai resmi Sudut Haramain Tour sebelum deployment.
# Jangan pernah menaruh rahasia (secret/token) di sini — semua variabel
# di bawah ini bersifat public dan terbaca di browser.

# Nomor WhatsApp resmi SHT untuk seluruh CTA & handoff lead (format internasional tanpa +)
NUXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"

# Domain kanonik situs
NUXT_PUBLIC_SITE_URL="https://sudutharamain.id"
